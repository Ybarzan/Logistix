# Convex deployment URL (get from `npx convex dev`)
CONVEX_DEPLOYMENT=

# Frontend Convex URL (Vite env var)
VITE_CONVEX_URL=

# Site URL Convex (utilisée par @convex-dev/auth pour les OAuth/redirects)
VITE_CONVEX_SITE_URL=

# ---- Mise en route ----
# 1. `npm run dev`  → démarre le backend Convex local, génère
#    convex/_generated/ et src/routeTree.gen.ts
# 2. Remplir la base de démo :
#    npx convex run seed --typecheck=disable
# 3. Connexion : créer un compte depuis /login (le premier compte est
#    rattaché à l'organisation "LogistiX")